# Negar por padrão: novos arquivos de estado não entram no Git.
/*
!/.gitignore
!/README.md
!/settings.json
!/keybindings.json
!/AGENTS.md
!/AGENTS.override.md
!/CLAUDE.md
!/SYSTEM.md
!/APPEND_SYSTEM.md
!/extensions/
!/skills/
!/prompts/
!/themes/
!/package.json
!/package-lock.json
!/pnpm-lock.yaml
!/yarn.lock
!/bun.lock

# Exclusões também dentro dos diretórios permitidos.
**/node_modules/
**/.git/
**/npm/
**/sessions/
**/cache/
**/.cache/
**/__pycache__/
**/.venv/
**/dist/
**/build/
**/coverage/
**/tmp/
**/temp/
**/auth.json
**/models.json
**/models-store.json
**/trust.json
**/.env
**/.env.*
**/.npmrc
**/.netrc
**/credentials*
**/secrets/
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/id_rsa*
**/id_ed25519*
**/*.log
**/*.sqlite*
**/*.db
**/*.bak
**/*.tmp
**/*.swp
**/.DS_Store
